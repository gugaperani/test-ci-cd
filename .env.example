# AWS Configuration
# Get these credentials from your AWS IAM console
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=eu-central-1
AWS_SECRET_NAME=users-ABMobile

# API Configuration
# Base URL for the authentication API
API_BASE_URL=https://api.adjarabet.com

# App Configuration
# Deep link scheme for mobile app authentication
APP_DEEP_LINK_SCHEME=adjarabet

# iOS Configuration
IOS_BUNDLE_ID=com.adjarabet.Mobile
IOS_PLATFORM_VERSION=18.2
IOS_DEVICE_NAME=iPhone 16 Pro

# Android Configuration
ANDROID_PACKAGE=com.adjarabet
ANDROID_PLATFORM_VERSION=14
ANDROID_DEVICE_NAME=Pixel 5 API 34

# Test Configuration
DEFAULT_TIMEOUT=10000
CONNECTION_RETRY_TIMEOUT=120000
CONNECTION_RETRY_COUNT=3
LOG_LEVEL=trace

# TestRail Configuration (Optional)
TESTRAIL_DOMAIN=aviator.testrail.io
TESTRAIL_USERNAME=your_email@example.com
TESTRAIL_API_TOKEN=your_testrail_api_token
TESTRAIL_PROJECT_ID=20
TESTRAIL_SUITE_ID=35

# Slack Configuration (Optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
