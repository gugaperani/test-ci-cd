{
  "name": "webdriverio-appium",
  "version": "1.0.0",
  "description": "Appium tests using WebdriverIO",
  "main": "index.js",
  "scripts": {
    "test": "wdio wdio.conf.ts",
    "test:ios": "wdio wdio.conf.ts",
    "test:android": "wdio config/adjarabet/android-wdio.conf.ts",
    "test:ios:adjarabet": "wdio config/adjarabet/ios-wdio.conf.ts",
    "test:adjarabet": "wdio wdio.conf.ts",
    "appium": "appium --allow-insecure chromedriver_autodownload",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "prepare": "husky install"
  },
  "keywords": [
    "webdriverio",
    "appium"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.920.0",
    "@aws-sdk/client-secrets-manager": "^3.922.0",
    "@wdio/cli": "^9.1.1",
    "appium": "^2.11.5",
    "body-parser": "^1.20.3",
    "follow-redirects": "^1.15.9",
    "path-to-regexp": "^8.2.0",
    "send": "^0.19.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.25.6",
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.4",
    "@babel/preset-typescript": "^7.27.1",
    "@babel/register": "^7.24.6",
    "@moroo/wdio-slack-reporter": "^8.1.0",
    "@types/mocha": "^10.0.10",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@wdio/allure-reporter": "^9.1.2",
    "@wdio/appium-service": "^9.1.1",
    "@wdio/browserstack-service": "^9.1.1",
    "@wdio/globals": "^9.17.0",
    "@wdio/junit-reporter": "^9.1.1",
    "@wdio/local-runner": "^9.1.1",
    "@wdio/mocha-framework": "^9.1.0",
    "@wdio/runner": "^9.1.1",
    "@wdio/spec-reporter": "^9.1.0",
    "@wdio/testrail-reporter": "^0.3.0",
    "@wdio/types": "^9.20.0",
    "allure-commandline": "^2.30.0",
    "appium-uiautomator2-driver": "^3.8.0",
    "appium-xcuitest-driver": "^7.35.1",
    "dotenv": "^17.2.3",
    "eslint": "^8.56.0",
    "eslint-plugin-wdio": "^9.0.8",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.1",
    "typescript": "^5.9.2",
    "webdriverio": "^9.1.1"
  }
}
